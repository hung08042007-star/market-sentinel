# Market Sentinel Environment Variables
# Telegram Alert Configuration (Optional for dry-run/local mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DATABASE_URL=sqlite:///data/sentinel.db

# Crawler Configuration
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RATE_LIMIT_DELAY=1.5
USER_AGENT=MarketSentinel/1.0 (+https://github.com/jerome/market-sentinel)
